# Copy this file to .env. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Firebase project used by the Expo client.
FIREBASE_PROJECT_ID=nutrivo-54be2

# Local development: point to a downloaded Firebase Admin service-account JSON.
# Keep that JSON outside the repository. Deployed services should prefer ADC.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/nutrivo-service-account.json

# Expo web development origins only. Replace with explicit deployed origins later.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# Development only: supports Expo choosing another local port such as 8082.
# Set this to an empty value in production.
ALLOWED_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1)(?::\d+)?$

MAX_UPLOAD_BYTES=8388608
GEMINI_TIMEOUT_SECONDS=35
